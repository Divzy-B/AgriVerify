# Non-secret Cloud Run environment variables. Keep real secrets in Secret Manager.
# Set false only after the Earth Engine project has the appropriate permission
# for the intended public use. Keep true for a non-commercial demonstration.
AGRIVERIFY_DEMO_MODE=true
AUTO_CREATE_SCHEMA=false
REQUIRE_FIREBASE_AUTH=true
FIREBASE_PROJECT_ID=agriverify-satellite
EARTH_ENGINE_PROJECT=agriverify-satellite
VOICE_PROVIDER=bolna

# Current public dashboard origin. Add custom domains here as comma-separated
# values after they are configured.
ALLOWED_ORIGINS=https://agriverify-voice-intelligence.divyabharambe25.chatgpt.site

# Non-secret Bolna agent identifier.
BOLNA_AGENT_ID=
