# Development defaults: intentionally use synthetic records, never satellite observations.
AGRIVERIFY_DEMO_MODE=true
DATABASE_URL=sqlite:///./agriverify.db
API_KEY=
ALLOWED_ORIGINS=http://localhost:3000
FIREBASE_PROJECT_ID=
# Keep false locally. Production Cloud Run uses true and validates Firebase ID tokens.
REQUIRE_FIREBASE_AUTH=false
# Keep true locally. Production runs Alembic once, then sets this false.
AUTO_CREATE_SCHEMA=true
VOICE_PROVIDER=bolna
BOLNA_API_KEY=
BOLNA_AGENT_ID=
# Optional shared value set as a custom header in Bolna's webhook configuration.
# Bolna docs do not document a signed webhook secret; this application only checks
# this explicit custom header when it is configured.
BOLNA_WEBHOOK_SECRET=
EARTH_ENGINE_PROJECT=
EARTH_ENGINE_SERVICE_ACCOUNT=
EARTH_ENGINE_PRIVATE_KEY_JSON=

